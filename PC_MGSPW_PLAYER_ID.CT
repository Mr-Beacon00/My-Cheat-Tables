  <LuaScript>local MODULE = "METAL GEAR SOLID PEACE WALKER.exe"
local MODE = 1   -- 1 = comrade, 2 = heroes, 3 = player

-- ========== 通用工具函数 ==========
local function safeGetAddress(expr)
    local a = getAddress(expr)
    if not a then
        print("getAddress failed: " .. expr)
    end
    return a
end

local function printPlayer(index, idAddr, nameAddr)
    if not idAddr or not nameAddr then return end

    local rawId = readInteger(idAddr)
    if rawId == nil or rawId == 0 then return end

    local SteamID3  = rawId ~ 0xB739CF89
    local SteamID64 = SteamID3 + 76561197960265728

    local name = readString(nameAddr) or "&lt;no name&gt;"

    print(string.format("[%d] %s", index, name))
    print("https://steamcommunity.com/profiles/" .. tostring(SteamID64))
end

-- ===9iomk ,======= MODE 1 / 2：动态列表 ==========
local function handleListMode(baseExpr)
    local base = safeGetAddress(baseExpr)
    if not base then return end

    local addr_NUMBER = base
    local addr_NAME   = base + 8
    local addr_ID     = base + 24

    local playerNumber = readInteger(addr_NUMBER)
    if playerNumber == nil then
        print("read player number failed")
        return
    end
    if playerNumber == 0 then
        print("no players")
        return
    end

    local step = 272
    for i = 0, playerNumber - 1 do
        local offset = i * step
        printPlayer(i + 1, addr_ID + offset, addr_NAME + offset)
    end
end

-- ========== MODE 3：固定 4 个玩家 ==========
local function handleFixedMode()
    -- 用表驱动，避免四段重复代码
    local players = {
        {id = '"' .. MODULE .. '"+150E054', name = '"' .. MODULE .. '"+150E05C'},
        {id = '"' .. MODULE .. '"+150EBE8', name = '"' .. MODULE .. '"+150EBF0'},
        {id = '"' .. MODULE .. '"+150F77C', name = '"' .. MODULE .. '"+150F784'},
        {id = '"' .. MODULE .. '"+1510310', name = '"' .. MODULE .. '"+1510318'},
    }

    for i, p in ipairs(players) do
        local idAddr   = safeGetAddress(p.id)
        local nameAddr = safeGetAddress(p.name)
        printPlayer(i, idAddr, nameAddr)
    end
end

-- ========== 分发 ==========
if MODE == 1 then
    handleListMode('"' .. MODULE .. '"+111BEE8')
elseif MODE == 2 then
    handleListMode('"' .. MODULE .. '"+110CE08')
elseif MODE == 3 then
    handleFixedMode()
else
    print("unknown MODE: " .. tostring(MODE))
end
</LuaScript>

