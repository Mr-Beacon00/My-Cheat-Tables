  <UserdefinedSymbols/>
  <LuaScript>-- walkman init
local idx = 0

for i = 0, 25 do
local offset = idx * 4
writeInteger(getAddress('"METAL GEAR SOLID PEACE WALKER.exe"+12AB568') + offset, i)
idx = idx + 1
end


-- music index
i=60 -- unused love deterrence

addr = getAddress('["METAL GEAR SOLID PEACE WALKER.exe"+E9DA10]+0x04+0x0c*i')

-- zeke mock battle
targetaddr1 = getAddress('["METAL GEAR SOLID PEACE WALKER.exe"+E9DA10]+0x2ec')

writeInteger(targetaddr1, readInteger(addr))
writeInteger(targetaddr1+4, readInteger(addr+4))
writeInteger(targetaddr1+8, readInteger(addr+8))

-- volume
local slot_addr1 = readQword(getAddress('"METAL GEAR SOLID PEACE WALKER.exe"+12A9728'))
writeByte(slot_addr1+0x30,160)
--print(readByte(slot_addr1+0x30))

</LuaScript>
